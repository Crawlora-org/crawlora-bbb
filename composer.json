{
  "name": "crawlora/bbb",
  "description": "Better Business Bureau client for the Crawlora hosted API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Bbb\\": "php/src/Crawlora/Bbb/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Bbb\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-bbb"
  }
}
