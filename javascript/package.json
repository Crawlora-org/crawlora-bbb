{
  "name": "@crawlora-org/bbb",
  "version": "0.4.0",
  "description": "Crawlora Better Business Bureau API client with 16 endpoints for business search, profiles, complaints, reviews, categories, and ScamTracker reports",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=bbb-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-bbb/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "bbb", "better-business-bureau", "bbb-api", "better-business-bureau-api", "bbb-scraper", "better-business-bureau-scraper", "bbb-data", "better-business-bureau-data", "bbb-business-search", "bbb-profiles", "bbb-complaints", "bbb-reviews", "bbb-categories", "bbb-scamtracker-reports"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-bbb",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
